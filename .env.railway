# ─── Railway - Variáveis de Ambiente ─────────────────────────────────────────
# Cole estas variáveis no painel Railway → seu serviço → Variables
#
# DATABASE_URL → Railway gera automaticamente ao adicionar PostgreSQL plugin
# NEXTAUTH_URL → será https://<seu-projeto>.up.railway.app

DATABASE_URL=postgresql://postgres:SENHA@postgres.railway.internal:5432/railway
NEXTAUTH_SECRET=GERE_COM_openssl_rand_base64_32
NEXTAUTH_URL=https://SEU-PROJETO.up.railway.app
INTERNAL_SECRET=token-secreto-entre-scraper-e-api
RESEND_API_KEY=re_sua_chave_aqui
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
