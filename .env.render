# ─── Render - Variáveis de Ambiente ──────────────────────────────────────────
# Cole estas variáveis em Environment → Environment Variables no Render
#
# DATABASE_URL → Render gera automaticamente ao criar o PostgreSQL
# NEXTAUTH_URL → será https://<seu-app>.onrender.com

DATABASE_URL=postgresql://tennishub:SENHA@dpg-xxx.render.com/tennishub
NEXTAUTH_SECRET=GERE_COM_openssl_rand_base64_32
NEXTAUTH_URL=https://SEU-APP.onrender.com
INTERNAL_SECRET=token-secreto-entre-scraper-e-api
RESEND_API_KEY=re_sua_chave_aqui
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
